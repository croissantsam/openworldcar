# Copy to .env and fill in. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-min-32-chars
BETTER_AUTH_URL=http://localhost:5173

# Dev local : fichier SQLite (clé optionnelle, défaut .data/app.db)
DATABASE_PATH=.data/app.db

# Prod (Turso) : quand TURSO_DATABASE_URL est défini, l'app utilise Turso
# au lieu du SQLite local. Création de la DB :
#   turso db create world-drive
#   turso db show world-drive --url      -> TURSO_DATABASE_URL
#   turso db tokens create world-drive   -> TURSO_AUTH_TOKEN
# Bootstrap du schéma (une fois, depuis ta machine — drizzle.config.ts
# bascule en dialecte `turso` quand TURSO_DATABASE_URL est défini) :
#   TURSO_DATABASE_URL=libsql://xxx.turso.io TURSO_AUTH_TOKEN=xxx pnpm db:migrate
# TURSO_DATABASE_URL=libsql://world-drive-xxx.turso.io
# TURSO_AUTH_TOKEN=
